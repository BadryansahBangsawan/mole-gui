<Window
    x:Class="Mole.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Mole.Views"
    Title="Mole"
    Width="1220"
    Height="780"
    MinWidth="1080"
    MinHeight="700">
    <Grid Background="{ThemeResource MoleCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource MoleCanvas}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="8">
                <Border Width="16" Height="16" CornerRadius="3" Background="{ThemeResource MoleBrand}">
                    <TextBlock Text="M" FontSize="9" FontWeight="SemiBold"
                               Foreground="{ThemeResource MoleOnBrand}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Mole" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource MoleTextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="NavPane" Background="{ThemeResource MoleCanvas}" Padding="10,8">
                <views:NavButton x:Name="NavOverview" Label="Overview" Click="OnNav" Tag="Overview" />
                <views:NavButton x:Name="NavClean" Label="Clean" Click="OnNav" Tag="Clean" />
                <views:NavButton x:Name="NavApplications" Label="Applications" Click="OnNav" Tag="Applications" />
                <views:NavButton x:Name="NavDisk" Label="Disk Explorer" Click="OnNav" Tag="DiskExplorer" />
                <views:NavButton x:Name="NavProjects" Label="Projects" Click="OnNav" Tag="Projects" />
                <views:NavButton x:Name="NavMaintenance" Label="Maintenance" Click="OnNav" Tag="Maintenance" />
                <Rectangle Height="1" Fill="{ThemeResource MoleBorder}" Margin="0,12" />
                <views:NavButton x:Name="NavHistory" Label="History" Click="OnNav" Tag="History" />
                <views:NavButton x:Name="NavSettings" Label="Settings" Click="OnNav" Tag="Settings" />
            </StackPanel>

            <Rectangle Grid.Column="1" Fill="{ThemeResource MoleBorder}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid BorderBrush="{ThemeResource MoleBorder}" BorderThickness="0,0,0,1" Padding="20,0">
                    <TextBlock x:Name="ToolbarTitle" Text="Overview" FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource MoleTextPrimary}" VerticalAlignment="Center" />
                    <StackPanel x:Name="ToolbarTrailing" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Spacing="8" />
                </Grid>
                <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>

        <Border x:Name="DialogScrim" Grid.RowSpan="2" Visibility="Collapsed"
                Background="#99000000">
            <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>

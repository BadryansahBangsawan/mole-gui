<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="MoleSidebarWidth">232</x:Double>
    <x:Double x:Key="MoleTitlebarHeight">32</x:Double>
    <x:Double x:Key="MoleCaptionWidth">46</x:Double>
    <x:Double x:Key="MoleButtonHeight">32</x:Double>
    <x:Double x:Key="MoleRadius">4</x:Double>
    <x:Double x:Key="MolePanelRadius">8</x:Double>
    <x:Double x:Key="MoleWindowWidth">1220</x:Double>
    <x:Double x:Key="MoleWindowHeight">780</x:Double>
    <CornerRadius x:Key="MoleCorner">4</CornerRadius>
    <CornerRadius x:Key="MolePanelCorner">8</CornerRadius>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="MoleCanvasColor">#FFFFFF</Color>
            <Color x:Key="MoleRaisedColor">#F5F7F4</Color>
            <Color x:Key="MoleHoverColor">#EDF2EC</Color>
            <Color x:Key="MoleSelectedColor">#E7F2E9</Color>
            <Color x:Key="MoleBorderColor">#DCE5DD</Color>
            <Color x:Key="MoleStrongBorderColor">#B8C8BA</Color>
            <Color x:Key="MoleTextPrimaryColor">#162019</Color>
            <Color x:Key="MoleTextSecondaryColor">#53635A</Color>
            <Color x:Key="MoleBrandColor">#315C41</Color>
            <Color x:Key="MoleOnBrandColor">#FFFFFF</Color>
            <Color x:Key="MoleBrandHoverColor">#254A34</Color>
            <Color x:Key="MoleSuccessColor">#1D7047</Color>
            <Color x:Key="MoleReviewColor">#8A5A0A</Color>
            <Color x:Key="MoleDangerColor">#B42318</Color>
            <Color x:Key="MoleReviewFillColor">#F8EED9</Color>
            <Color x:Key="MoleDangerFillColor">#FCEBE9</Color>
            <Color x:Key="MoleSuccessFillColor">#E6F4EC</Color>
            <Color x:Key="MoleOnDangerColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="MoleCanvas" Color="{StaticResource MoleCanvasColor}" />
            <SolidColorBrush x:Key="MoleRaised" Color="{StaticResource MoleRaisedColor}" />
            <SolidColorBrush x:Key="MoleHover" Color="{StaticResource MoleHoverColor}" />
            <SolidColorBrush x:Key="MoleSelected" Color="{StaticResource MoleSelectedColor}" />
            <SolidColorBrush x:Key="MoleBorder" Color="{StaticResource MoleBorderColor}" />
            <SolidColorBrush x:Key="MoleStrongBorder" Color="{StaticResource MoleStrongBorderColor}" />
            <SolidColorBrush x:Key="MoleTextPrimary" Color="{StaticResource MoleTextPrimaryColor}" />
            <SolidColorBrush x:Key="MoleTextSecondary" Color="{StaticResource MoleTextSecondaryColor}" />
            <SolidColorBrush x:Key="MoleBrand" Color="{StaticResource MoleBrandColor}" />
            <SolidColorBrush x:Key="MoleOnBrand" Color="{StaticResource MoleOnBrandColor}" />
            <SolidColorBrush x:Key="MoleBrandHover" Color="{StaticResource MoleBrandHoverColor}" />
            <SolidColorBrush x:Key="MoleSuccess" Color="{StaticResource MoleSuccessColor}" />
            <SolidColorBrush x:Key="MoleReview" Color="{StaticResource MoleReviewColor}" />
            <SolidColorBrush x:Key="MoleDanger" Color="{StaticResource MoleDangerColor}" />
            <SolidColorBrush x:Key="MoleReviewFill" Color="{StaticResource MoleReviewFillColor}" />
            <SolidColorBrush x:Key="MoleDangerFill" Color="{StaticResource MoleDangerFillColor}" />
            <SolidColorBrush x:Key="MoleSuccessFill" Color="{StaticResource MoleSuccessFillColor}" />
            <SolidColorBrush x:Key="MoleOnDanger" Color="{StaticResource MoleOnDangerColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="MoleCanvasColor">#0B100D</Color>
            <Color x:Key="MoleRaisedColor">#17211A</Color>
            <Color x:Key="MoleHoverColor">#1D2B21</Color>
            <Color x:Key="MoleSelectedColor">#203B29</Color>
            <Color x:Key="MoleBorderColor">#2E4032</Color>
            <Color x:Key="MoleStrongBorderColor">#506553</Color>
            <Color x:Key="MoleTextPrimaryColor">#F2F7F1</Color>
            <Color x:Key="MoleTextSecondaryColor">#AABCAF</Color>
            <Color x:Key="MoleBrandColor">#B8E1C0</Color>
            <Color x:Key="MoleOnBrandColor">#0B100D</Color>
            <Color x:Key="MoleBrandHoverColor">#D4F0DA</Color>
            <Color x:Key="MoleSuccessColor">#86D7A2</Color>
            <Color x:Key="MoleReviewColor">#F0CA83</Color>
            <Color x:Key="MoleDangerColor">#FFB4A8</Color>
            <Color x:Key="MoleReviewFillColor">#3A2E16</Color>
            <Color x:Key="MoleDangerFillColor">#3A1C18</Color>
            <Color x:Key="MoleSuccessFillColor">#163226</Color>
            <Color x:Key="MoleOnDangerColor">#0B100D</Color>
            <SolidColorBrush x:Key="MoleCanvas" Color="{StaticResource MoleCanvasColor}" />
            <SolidColorBrush x:Key="MoleRaised" Color="{StaticResource MoleRaisedColor}" />
            <SolidColorBrush x:Key="MoleHover" Color="{StaticResource MoleHoverColor}" />
            <SolidColorBrush x:Key="MoleSelected" Color="{StaticResource MoleSelectedColor}" />
            <SolidColorBrush x:Key="MoleBorder" Color="{StaticResource MoleBorderColor}" />
            <SolidColorBrush x:Key="MoleStrongBorder" Color="{StaticResource MoleStrongBorderColor}" />
            <SolidColorBrush x:Key="MoleTextPrimary" Color="{StaticResource MoleTextPrimaryColor}" />
            <SolidColorBrush x:Key="MoleTextSecondary" Color="{StaticResource MoleTextSecondaryColor}" />
            <SolidColorBrush x:Key="MoleBrand" Color="{StaticResource MoleBrandColor}" />
            <SolidColorBrush x:Key="MoleOnBrand" Color="{StaticResource MoleOnBrandColor}" />
            <SolidColorBrush x:Key="MoleBrandHover" Color="{StaticResource MoleBrandHoverColor}" />
            <SolidColorBrush x:Key="MoleSuccess" Color="{StaticResource MoleSuccessColor}" />
            <SolidColorBrush x:Key="MoleReview" Color="{StaticResource MoleReviewColor}" />
            <SolidColorBrush x:Key="MoleDanger" Color="{StaticResource MoleDangerColor}" />
            <SolidColorBrush x:Key="MoleReviewFill" Color="{StaticResource MoleReviewFillColor}" />
            <SolidColorBrush x:Key="MoleDangerFill" Color="{StaticResource MoleDangerFillColor}" />
            <SolidColorBrush x:Key="MoleSuccessFill" Color="{StaticResource MoleSuccessFillColor}" />
            <SolidColorBrush x:Key="MoleOnDanger" Color="{StaticResource MoleOnDangerColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
